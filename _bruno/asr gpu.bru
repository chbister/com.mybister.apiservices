meta {
  name: asr gpu (lokal)
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/asr/v1/asr/gpu
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  language: auto
  timestamps: true
  word_timestamps: false
  model_size: small
  ~file: @file(/Users/christianbister/Downloads/sample.wav)
  ~file_url: https://example.com/audio.m4a
}

settings {
  encodeUrl: false
  timeout: 0
}
