CALLBACK_AUTH_SECRET=callbackAuthSecret
HF_TOKEN=huggingfaceSecretToken
EDGE_NETWORK_NAME=dev-shared-network

# --- Hetzner DNS (tools/hetzner_dns, siehe docs/hetzner-dns.md) ---
# Hetzner-Cloud-API-Token mit Read & Write auf die DNS-Zone. Niemals echte Werte committen.
HETZNER_API_TOKEN=replace-with-hetzner-cloud-api-token
HETZNER_DNS_ZONE=mybister.com
HETZNER_DNS_TTL=60
API_SERVICES_DOMAIN=api.mybister.com
DEFAULT_DOCKER_HOST=b03.mybister.com

# --- Debug-Processor: HTTPS-Endpunkte der Analyse-Kette (Audit R1) ---
# Dev-Default sind die internen Docker-DNS-Adressen aus docker-compose.yml.
# Nur der Prod-Host, der debug-processor startet (aktuell b01), setzt diese
# Werte in seiner Host-Env-Datei (env.apiservices), damit die Kette
# hostuebergreifend laeuft und sentiment/ner auf anderen Hosts liegen duerfen.
# Die Aufrufe laufen dann durch Traefik und brauchen den Key im
# X-API-Key-Header -> dafuer wird API_KEY an debug-processor durchgereicht.
# SENTIMENT_URL=https://sentiment.api.mybister.com/v1/sentiment
# EMOTION_BASE_URL=https://emotion.api.mybister.com/v1/emotion
# EMOTION_NUANCE_URL=https://emotion-nuance.api.mybister.com/v1/emotion
# EMOTION_VIBE_URL=https://emotion-vibe.api.mybister.com/v1/emotion
# EMOTION_STATE_URL=https://emotion-state.api.mybister.com/v1/emotion
# NER_URL=https://ner.api.mybister.com/v1/ner

# --- OCR PDF Service (ocrpdf-service, nginx-LB vor skalierten Replicas) ---
OCRPDF_REPLICAS=2
TEMP_MAX_AGE_HOURS=24
CALLBACK_TIMEOUT_MS=30000

# --- GlitchTip / Fehler-Tracking (Sentry-kompat, siehe docs/glitchtip.md) ---
# DSN aus dem GlitchTip-Projekt (Settings -> Client Keys / DSN).
# Leer lassen oder weglassen = Fehler-Tracking deaktiviert. Niemals echte DSNs committen.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release-Tag, z.B. Git-SHA des Deployments (optional)
SENTRY_RELEASE=
# Auf "1" setzen, um beim Start einmal ein Test-Event zu senden (optional)
SENTRY_SEND_TEST_EVENT=